# Copiar a .env y completar con los valores del proyecto de Supabase (pídelos al Scrum Master).
# Nunca subir .env a git.

# API HTTP: en Render, PORT se asigna automáticamente.
PORT=3000
# Web que puede llamar a la API (CORS) y adonde llevan los enlaces de invitación.
WEB_URL=http://localhost:5173
# Orígenes adicionales para CORS, separados por comas (por ejemplo, una vista previa de Vercel).
CORS_ORIGENES=

SUPABASE_PROJECT_REF=txjgwdjeqgzcrxuyspyb
SUPABASE_URL=https://txjgwdjeqgzcrxuyspyb.supabase.co
SUPABASE_DB_PASSWORD=

# La publishable se usa en la web y para verificar JWT en la API; la secret solo en la API.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_LOGOS_BUCKET=logos

# Prisma: pooler en modo transacción para la app y en modo sesión para migraciones
DATABASE_URL=postgresql://postgres.txjgwdjeqgzcrxuyspyb:[CONTRASEÑA]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.txjgwdjeqgzcrxuyspyb:[CONTRASEÑA]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
