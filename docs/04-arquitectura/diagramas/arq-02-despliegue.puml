@startuml arq-02-despliegue
!include ../../estilo.iuml
title Diagrama de despliegue
node "Dispositivo del usuario" as DEV {
  component "Navegador web\n(computadora, tableta o celular)" as NAV
}
node "Vercel (CDN)" as VER {
  artifact "apps/web\nReact + Vite (SPA estática)" as WEB
}
node "Render (Node.js 24)" as REN {
  component "apps/api\nNestJS + Prisma 7" as API
}
node "Supabase (us-east-1)" as SUP {
  database "PostgreSQL 17\n• tablas con RLS\n• triggers contables\n• bitácora inmutable" as PG
  component "Supabase Auth" as AUTH
  component "Storage\n(logotipos, PDF)" as STO
  component "Pooler (Supavisor)\n6543 transacción · 5432 sesión" as POOL
}
node "GitHub" as GH {
  component "Repositorio + Actions\n(lint, pruebas, build)" as CI
}

NAV --> WEB : HTTPS
NAV --> API : HTTPS / JSON\n(token JWT)
NAV --> AUTH : inicio de sesión
API --> POOL : TCP 6543\nDATABASE_URL
POOL --> PG
API --> AUTH : valida JWT
API --> STO : clave secreta
CI --> VER : despliegue de main
CI --> REN : despliegue de main
CI ..> PG : migraciones\n(DIRECT_URL, solo DBA)
@enduml
