// Modelo de datos del sistema contable (HU-03).
// Las reglas que el esquema de Prisma no puede expresar (cuadre, períodos cerrados, correlativos,
// bitácora inmutable, seguridad) están en la migración 20261110000100_reglas_contables.
// Convención: modelos en PascalCase, tablas y columnas en snake_case.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enumeraciones ───────────────────────────

enum TipoContribuyente {
  persona_natural
  sociedad

  @@map("tipo_contribuyente")
}

enum ClasificacionContribuyente {
  grande
  mediano
  otro

  @@map("clasificacion_contribuyente")
}

enum ModoNumeracion {
  mensual
  anual
  por_tipo

  @@map("modo_numeracion")
}

enum FormatoEstados {
  clase
  niif_pymes

  @@map("formato_estados")
}

enum MetodoValuacion {
  promedio_ponderado
  peps

  @@map("metodo_valuacion")
}

enum SistemaInventario {
  perpetuo
  analitico

  @@map("sistema_inventario")
}

enum Naturaleza {
  deudora
  acreedora

  @@map("naturaleza")
}

/// Clase de la cuenta según el primer dígito del catálogo de la clase
enum TipoCuenta {
  activo
  pasivo
  patrimonio
  costos_gastos
  ingresos
  liquidadora
  orden

  @@map("tipo_cuenta")
}

enum EstadoPeriodo {
  abierto
  cerrado

  @@map("estado_periodo")
}

enum TipoPartida {
  apertura
  operacion
  ajuste
  cierre
  reapertura
  reversion

  @@map("tipo_partida")
}

enum EstadoPartida {
  borrador
  contabilizada
  anulada

  @@map("estado_partida")
}

enum TipoRespaldo {
  empresa
  sucursal

  @@map("tipo_respaldo")
}

// ─────────────────────────── Organización ───────────────────────────

model Empresa {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String                     @db.VarChar(200)
  nombreComercial    String?                    @map("nombre_comercial") @db.VarChar(200)
  nit                String                     @unique @db.VarChar(17)
  nrc                String?                    @db.VarChar(10)
  tipoContribuyente  TipoContribuyente          @map("tipo_contribuyente")
  clasificacion      ClasificacionContribuyente @default(otro)
  actividadEconomica String?                    @map("actividad_economica") @db.VarChar(200)
  direccion          String?                    @db.VarChar(300)
  telefono           String?                    @db.VarChar(20)
  correo             String?                    @db.VarChar(150)
  logoUrl            String?                    @map("logo_url")
  modoNumeracion     ModoNumeracion             @default(anual) @map("modo_numeracion")
  formatoEstados     FormatoEstados             @default(clase) @map("formato_estados")
  metodoValuacion    MetodoValuacion            @default(promedio_ponderado) @map("metodo_valuacion")
  sistemaInventario  SistemaInventario          @default(perpetuo) @map("sistema_inventario")
  activa             Boolean                    @default(true)
  creadoEn           DateTime                   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime                   @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  sucursales   Sucursal[]
  membresias   Membresia[]
  cuentas      Cuenta[]
  versionesPartidas PartidaVersion[]
  cuentasTesoreria  CuentaTesoreria[]
  categoriasProducto CategoriaProducto[]
  productos          Producto[]
  movimientosInventario MovimientoInventario[]
  empleados             Empleado[]
  configuracionesPlanilla ConfiguracionPlanilla[]
  planillasCalculadas    PlanillaCalculada[]
  presentacionesPlanilla PresentacionPlanilla[]
  ejercicios   Ejercicio[]
  periodos     Periodo[]
  partidas     Partida[]
  detalles     PartidaDetalle[]
  correlativos Correlativo[]
  respaldos    Respaldo[]

  @@map("empresas")
}

model Sucursal {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId             String   @map("empresa_id") @db.Uuid
  nombre                String   @db.VarChar(150)
  /// Código de establecimiento asignado por Hacienda (4 caracteres en el DTE)
  codigoEstablecimiento String   @map("codigo_establecimiento") @db.VarChar(4)
  /// Código de punto de venta (4 caracteres en el DTE)
  codigoPuntoVenta      String   @default("0001") @map("codigo_punto_venta") @db.VarChar(4)
  direccion             String?  @db.VarChar(300)
  esMatriz              Boolean  @default(false) @map("es_matriz")
  activa                Boolean  @default(true)
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn         DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  asignadas MembresiaSucursal[]
  partidas  Partida[]
  cuentasTesoreria CuentaTesoreria[]
  movimientosInventario MovimientoInventario[]
  empleados             Empleado[]
  planillasCalculadas   PlanillaCalculada[]
  respaldos             Respaldo[]

  @@unique([empresaId, codigoEstablecimiento, codigoPuntoVenta])
  @@index([empresaId])
  @@map("sucursales")
}

/// Perfil del usuario. El id es el mismo de auth.users de Supabase; la API lo crea al primer inicio de sesión.
model Usuario {
  id            String   @id @db.Uuid
  nombre        String   @db.VarChar(150)
  correo        String   @unique @db.VarChar(150)
  idioma        String   @default("es") @db.VarChar(5)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  membresias Membresia[]
  presentacionesPlanilla PresentacionPlanilla[]
  respaldos             Respaldo[]

  @@map("usuarios")
}

model Rol {
  id     Int    @id @db.SmallInt
  codigo String @unique @db.VarChar(30)
  nombre String @db.VarChar(60)

  permisos   RolPermiso[]
  membresias Membresia[]

  @@map("roles")
}

/// Par módulo–acción de la matriz de permisos (por ejemplo, partidas.contabilizar)
model Permiso {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  modulo      String @db.VarChar(40)
  accion      String @db.VarChar(30)
  descripcion String @db.VarChar(200)

  roles RolPermiso[]

  @@unique([modulo, accion])
  @@map("permisos")
}

model RolPermiso {
  rolId     Int @map("rol_id") @db.SmallInt
  permisoId Int @map("permiso_id") @db.SmallInt

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("rol_permisos")
}

/// Acceso de un usuario a una empresa con un rol
model Membresia {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  empresaId       String   @map("empresa_id") @db.Uuid
  rolId           Int      @map("rol_id") @db.SmallInt
  /// true: ve todas las sucursales; false: solo las de membresia_sucursales.
  /// La base exige true para administrador y contador, y false para auxiliar y consulta (membresias_alcance_por_rol).
  todasSucursales Boolean  @default(false) @map("todas_sucursales")
  activa          Boolean  @default(true)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario    Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empresa    Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  rol        Rol                 @relation(fields: [rolId], references: [id])
  sucursales MembresiaSucursal[]

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([rolId])
  @@map("membresias")
}

model MembresiaSucursal {
  membresiaId String @map("membresia_id") @db.Uuid
  sucursalId  String @map("sucursal_id") @db.Uuid

  membresia Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  sucursal  Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([membresiaId, sucursalId])
  @@index([sucursalId])
  @@map("membresia_sucursales")
}

// ─────────────────────────── Catálogo de cuentas ───────────────────────────

/// Niveles por longitud del código: 1 clase, 2 rubro, 4 cuenta de mayor, 6 subcuenta, 8 detalle, 10 analítica.
/// El nivel y la cuenta padre los calcula un trigger a partir del código.
model Cuenta {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String     @map("empresa_id") @db.Uuid
  codigo        String     @db.VarChar(10)
  nombre        String     @db.VarChar(200)
  nivel         Int        @default(0) @db.SmallInt
  naturaleza    Naturaleza
  tipo          TipoCuenta
  cuentaPadreId String?    @map("cuenta_padre_id") @db.Uuid
  activa        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime   @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa  Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  padre    Cuenta?          @relation("Jerarquia", fields: [cuentaPadreId], references: [id], onDelete: Restrict)
  hijas    Cuenta[]         @relation("Jerarquia")
  detalles PartidaDetalle[]
  tesoreria CuentaTesoreria?

  @@unique([empresaId, codigo])
  @@index([cuentaPadreId])
  @@map("cuentas")
}

/// Plantilla del catálogo empresarial; se copia a cada empresa nueva con interno.copiar_catalogo_base(empresa).
model CatalogoBase {
  codigo               String     @id @db.VarChar(10)
  nombre               String     @db.VarChar(200)
  nombrePersonaNatural String?    @map("nombre_persona_natural") @db.VarChar(200)
  /// ambos, sociedad o persona_natural
  aplica               String     @default("ambos") @db.VarChar(20)
  naturaleza           Naturaleza
  tipo                 TipoCuenta

  @@map("catalogo_base")
}

// ─────────────────────────── Ejercicios y períodos ───────────────────────────

model Ejercicio {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String        @map("empresa_id") @db.Uuid
  anio        Int           @db.SmallInt
  fechaInicio DateTime      @map("fecha_inicio") @db.Date
  fechaFin    DateTime      @map("fecha_fin") @db.Date
  estado      EstadoPeriodo @default(abierto)
  creadoEn    DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  periodos Periodo[]

  @@unique([empresaId, anio])
  @@map("ejercicios")
}

/// Los doce períodos se crean automáticamente al insertar el ejercicio (trigger).
model Periodo {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String        @map("empresa_id") @db.Uuid
  ejercicioId      String        @map("ejercicio_id") @db.Uuid
  mes              Int           @db.SmallInt
  fechaInicio      DateTime      @map("fecha_inicio") @db.Date
  fechaFin         DateTime      @map("fecha_fin") @db.Date
  estado           EstadoPeriodo @default(abierto)
  cerradoEn        DateTime?     @map("cerrado_en") @db.Timestamptz(6)
  /// Motivo de la última reapertura; obligatorio para reabrir (lo exige un trigger)
  motivoReapertura String?       @map("motivo_reapertura")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  partidas  Partida[]

  @@unique([ejercicioId, mes])
  @@index([empresaId, fechaInicio])
  @@map("periodos")
}

// ─────────────────────────── Partidas ───────────────────────────

model Partida {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String        @map("empresa_id") @db.Uuid
  sucursalId         String        @map("sucursal_id") @db.Uuid
  /// Lo asigna un trigger según la fecha
  periodoId          String?       @map("periodo_id") @db.Uuid
  fecha              DateTime      @db.Date
  tipo               TipoPartida   @default(operacion)
  estado             EstadoPartida @default(borrador)
  /// Correlativo asignado al contabilizar, dentro de su ámbito de numeración
  numero             Int?
  ambitoNumeracion   String?       @map("ambito_numeracion") @db.VarChar(40)
  concepto           String?
  documentoTipo      String?       @map("documento_tipo") @db.VarChar(30)
  documentoNumero    String?       @map("documento_numero") @db.VarChar(60)
  /// Módulo que generó la partida: manual, compras, ventas, planilla…
  origen             String        @default("manual") @db.VarChar(30)
  origenId           String?       @map("origen_id") @db.Uuid
  partidaRevertidaId String?       @map("partida_revertida_id") @db.Uuid
  version            Int           @default(1)
  creadoPor          String?       @map("creado_por") @db.Uuid
  contabilizadoPor   String?       @map("contabilizado_por") @db.Uuid
  contabilizadoEn    DateTime?     @map("contabilizado_en") @db.Timestamptz(6)
  anuladoPor         String?       @map("anulado_por") @db.Uuid
  anuladoEn          DateTime?     @map("anulado_en") @db.Timestamptz(6)
  motivoAnulacion    String?       @map("motivo_anulacion")
  creadoEn           DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  periodo     Periodo?         @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  revertida   Partida?         @relation("Reversion", fields: [partidaRevertidaId], references: [id], onDelete: Restrict)
  reversiones Partida[]        @relation("Reversion")
  detalles    PartidaDetalle[]
  versiones   PartidaVersion[]
  planillasCalculadas PlanillaCalculada[]

  @@unique([empresaId, ambitoNumeracion, numero])
  @@index([empresaId, fecha])
  @@index([empresaId, estado])
  @@index([periodoId])
  @@index([sucursalId])
  @@index([partidaRevertidaId])
  @@map("partidas")
}

model PartidaDetalle {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partidaId String  @map("partida_id") @db.Uuid
  /// Copia de la empresa de la partida (la fija un trigger) para filtrar y asegurar sin joins
  empresaId String  @map("empresa_id") @db.Uuid
  cuentaId  String  @map("cuenta_id") @db.Uuid
  concepto  String?
  debe      Decimal @default(0) @db.Decimal(14, 2)
  haber     Decimal @default(0) @db.Decimal(14, 2)
  orden     Int     @default(0) @db.SmallInt

  partida Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  @@index([partidaId])
  @@index([cuentaId])
  @@index([empresaId])
  @@map("partida_detalles")
}

/// Cómo estaba una partida contabilizada antes de cada edición (cabecera y líneas); la versión actual sigue en Partida
model PartidaVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  partidaId      String   @map("partida_id") @db.Uuid
  /// Versión que tenía la partida antes de la edición
  version        Int
  datos          Json
  lineas         Json
  reemplazadaPor String?  @map("reemplazada_por") @db.Uuid
  reemplazadaEn  DateTime @default(now()) @map("reemplazada_en") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  partida Partida @relation(fields: [partidaId], references: [id], onDelete: Restrict)

  @@unique([partidaId, version])
  @@index([empresaId])
  @@map("partida_versiones")
}

/// Último número usado por ámbito (por ejemplo "2026", "2026-11" o "2026-ajuste")
model Correlativo {
  empresaId String @map("empresa_id") @db.Uuid
  ambito    String @db.VarChar(40)
  ultimo    Int    @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, ambito])
  @@map("correlativos")
}

// ─────────────────────────── Auditoría ───────────────────────────

/// Bitácora inmutable: la llenan triggers; no admite UPDATE, DELETE ni TRUNCATE.
model Bitacora {
  id              BigInt   @id @default(autoincrement())
  empresaId       String?  @map("empresa_id") @db.Uuid
  usuarioId       String?  @map("usuario_id") @db.Uuid
  tabla           String   @db.VarChar(60)
  registroId      String?  @map("registro_id") @db.VarChar(60)
  accion          String   @db.VarChar(30)
  datosAnteriores Json?    @map("datos_anteriores")
  datosNuevos     Json?    @map("datos_nuevos")
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([empresaId, creadoEn])
  @@index([tabla, registroId])
  @@map("bitacora")
}

enum TipoCuentaTesoreria {
  caja
  banco

  @@map("tipo_cuenta_tesoreria")
}

/// Caja o cuenta bancaria de la empresa, vinculada a su cuenta contable de efectivo (HU-76)
model CuentaTesoreria {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  sucursalId    String?             @map("sucursal_id") @db.Uuid
  cuentaId      String              @unique @map("cuenta_id") @db.Uuid
  tipo          TipoCuentaTesoreria
  nombre        String              @db.VarChar(100)
  banco         String?             @db.VarChar(80)
  numeroCuenta  String?             @map("numero_cuenta") @db.VarChar(40)
  activa        Boolean             @default(true)
  creadoEn      DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime            @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  cuenta   Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, banco, numeroCuenta])
  @@index([empresaId])
  @@map("cuentas_tesoreria")
}

/// Categoría con la que se agrupan los productos de una empresa (HU-64)
model CategoriaProducto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  nombre        String   @db.VarChar(80)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@unique([id, empresaId])
  @@unique([empresaId, nombre])
  @@map("categorias_producto")
}

/// Producto que la empresa compra y vende; su código es único por empresa (HU-64)
model Producto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  categoriaId   String?  @map("categoria_id") @db.Uuid
  codigo        String   @db.VarChar(30)
  nombre        String   @db.VarChar(150)
  unidadMedida  String   @default("unidad") @map("unidad_medida") @db.VarChar(20)
  precioVenta   Decimal  @default(0) @map("precio_venta") @db.Decimal(14, 2)
  /// Método propio; si es nulo se usa el de la empresa
  metodoValuacion   MetodoValuacion? @map("metodo_valuacion")
  existenciaMinima  Decimal  @default(0) @map("existencia_minima") @db.Decimal(14, 4)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categoria CategoriaProducto? @relation(fields: [categoriaId, empresaId], references: [id, empresaId], onDelete: Restrict)
  movimientos MovimientoInventario[]

  @@unique([empresaId, codigo])
  @@index([empresaId, categoriaId])
  @@map("productos")
}

enum TipoMovimientoInventario {
  entrada
  salida

  @@map("tipo_movimiento_inventario")
}

/// Entrada o salida de un producto en una sucursal; el kardex se arma con ellas y no se modifican (HU-65)
model MovimientoInventario {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Orden de registro (columna de identidad)
  secuencia     BigInt                   @default(autoincrement())
  empresaId     String                   @map("empresa_id") @db.Uuid
  sucursalId    String                   @map("sucursal_id") @db.Uuid
  productoId    String                   @map("producto_id") @db.Uuid
  fecha         DateTime                 @db.Date
  tipo          TipoMovimientoInventario
  cantidad      Decimal                  @db.Decimal(14, 4)
  costoUnitario Decimal                  @map("costo_unitario") @db.Decimal(14, 4)
  costoTotal    Decimal                  @map("costo_total") @db.Decimal(14, 2)
  referencia    String?                  @db.VarChar(60)
  creadoEn      DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([productoId, sucursalId, fecha, secuencia], map: "movimientos_inventario_kardex_idx")
  @@index([empresaId])
  @@map("movimientos_inventario")
}

/// Persona que recibe planilla en una sucursal de la empresa (HU-70).
model Empleado {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  sucursalId    String   @map("sucursal_id") @db.Uuid
  nombres       String   @db.VarChar(100)
  apellidos     String   @db.VarChar(100)
  dui           String   @db.VarChar(20)
  nit           String   @db.VarChar(20)
  numeroIsss    String   @map("numero_isss") @db.VarChar(20)
  nup           String   @db.VarChar(20)
  puesto        String   @db.VarChar(100)
  area          String?  @db.VarChar(100)
  salario       Decimal  @db.Decimal(14, 2)
  fechaIngreso  DateTime @map("fecha_ingreso") @db.Date
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  planillasCalculadas PlanillaCalculada[]

  @@unique([id, empresaId])
  @@unique([empresaId, dui])
  @@unique([empresaId, nit])
  @@unique([empresaId, numeroIsss])
  @@unique([empresaId, nup])
  @@index([empresaId, sucursalId])
  @@map("empleados")
}

enum TipoPlanillaOficial {
  isss
  afp

  @@map("tipo_planilla_oficial")
}

/// Cifras por persona guardadas al generar la partida mensual para las planillas oficiales (HU-75).
model PlanillaCalculada {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  sucursalId       String   @map("sucursal_id") @db.Uuid
  periodo          DateTime @db.Date
  partidaId        String   @map("partida_id") @db.Uuid
  empleadoId       String   @map("empleado_id") @db.Uuid
  nombres          String   @db.VarChar(100)
  apellidos        String   @db.VarChar(100)
  dui              String   @db.VarChar(20)
  numeroIsss       String   @map("numero_isss") @db.VarChar(20)
  nup              String   @db.VarChar(20)
  salarioCotizable Decimal  @map("salario_cotizable") @db.Decimal(14, 2)
  isssLaboral      Decimal  @map("isss_laboral") @db.Decimal(14, 2)
  isssPatronal     Decimal  @map("isss_patronal") @db.Decimal(14, 2)
  afpLaboral       Decimal  @map("afp_laboral") @db.Decimal(14, 2)
  afpPatronal      Decimal  @map("afp_patronal") @db.Decimal(14, 2)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  partida  Partida  @relation(fields: [partidaId], references: [id], onDelete: Restrict)
  empleado Empleado @relation(fields: [empleadoId, empresaId], references: [id, empresaId], onDelete: Restrict)

  @@unique([empresaId, periodo, empleadoId], map: "planillas_calculadas_empresa_periodo_empleado_unq")
  @@index([empresaId, periodo])
  @@index([sucursalId, periodo])
  @@map("planillas_calculadas")
}

/// Registro de quién y cuándo presentó la planilla de una institución por período (HU-75).
model PresentacionPlanilla {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId    String              @map("empresa_id") @db.Uuid
  periodo      DateTime            @db.Date
  tipo         TipoPlanillaOficial
  presentadaPor String             @map("presentada_por") @db.Uuid
  presentadaEn DateTime            @default(now()) @map("presentada_en") @db.Timestamptz(6)

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario   Usuario @relation(fields: [presentadaPor], references: [id], onDelete: Restrict)

  @@unique([empresaId, periodo, tipo], map: "planillas_presentaciones_empresa_periodo_tipo_unq")
  @@index([empresaId, periodo])
  @@map("planillas_presentaciones")
}

/// Archivo inmutable de respaldo de los datos de una empresa o una sucursal (HU-13).
model Respaldo {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String      @map("empresa_id") @db.Uuid
  sucursalId    String?     @map("sucursal_id") @db.Uuid
  tipo          TipoRespaldo
  nombreArchivo String      @map("nombre_archivo") @db.VarChar(200)
  contenido     Json
  sha256        String      @db.Char(64)
  creadoPor     String      @map("creado_por") @db.Uuid
  creadoEn      DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario  Usuario   @relation(fields: [creadoPor], references: [id], onDelete: Restrict)

  @@index([empresaId, creadoEn(sort: Desc)])
  @@map("respaldos")
}

/// Tasas de nómina con vigencia histórica por empresa (HU-71).
model ConfiguracionPlanilla {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  vigenteDesde      DateTime @map("vigente_desde") @db.Date
  tasaIsssLaboral   Decimal  @map("tasa_isss_laboral") @db.Decimal(5, 2)
  tasaIsssPatronal  Decimal  @map("tasa_isss_patronal") @db.Decimal(5, 2)
  techoIsss         Decimal  @map("techo_isss") @db.Decimal(14, 2)
  tasaAfpLaboral    Decimal  @map("tasa_afp_laboral") @db.Decimal(5, 2)
  tasaAfpPatronal   Decimal  @map("tasa_afp_patronal") @db.Decimal(5, 2)
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tramos  TramoRetencionPlanilla[]

  @@unique([id, empresaId])
  @@unique([empresaId, vigenteDesde])
  @@index([empresaId, vigenteDesde])
  @@map("configuraciones_planilla")
}

/// Tramo progresivo de la tabla mensual de retención de renta (HU-71).
model TramoRetencionPlanilla {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  configuracionId   String   @map("configuracion_id") @db.Uuid
  orden             Int      @db.SmallInt
  desde             Decimal  @db.Decimal(14, 2)
  hasta             Decimal? @db.Decimal(14, 2)
  porcentaje        Decimal  @db.Decimal(5, 2)
  cuotaFija         Decimal  @map("cuota_fija") @db.Decimal(14, 2)

  configuracion ConfiguracionPlanilla @relation(fields: [configuracionId, empresaId], references: [id, empresaId], onDelete: Restrict)

  @@unique([configuracionId, orden])
  @@index([empresaId, configuracionId])
  @@map("tramos_retencion_planilla")
}
